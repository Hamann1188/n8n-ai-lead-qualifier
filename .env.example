# Copy to .env and fill in. Never commit .env.

# n8n
# Generate once and keep it: uv run python -c "import secrets; print(secrets.token_hex(32))"
N8N_ENCRYPTION_KEY=
GENERIC_TIMEZONE=Asia/Tashkent
TZ=Asia/Tashkent

# PostgreSQL for n8n state
POSTGRES_USER=n8n
POSTGRES_PASSWORD=
POSTGRES_DB=n8n

# Shared secret the website sends in the X-Webhook-Secret header
LEADQ_WEBHOOK_SECRET=
LEADQ_WEBHOOK_URL=http://localhost:5678/webhook/lead-intake

# Python tooling (eval, test leads). n8n itself keeps its Anthropic key in its credential store.
LEADQ_ANTHROPIC_API_KEY=
# Set explicitly so a globally exported ANTHROPIC_BASE_URL (e.g. a local proxy) is never picked up
LEADQ_ANTHROPIC_BASE_URL=https://api.anthropic.com
LEADQ_MODEL=claude-opus-5-5
